{
  "name": "fita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail -n api,web -c blue,green \"npm run dev -w @fita/backend\" \"npm run dev -w @fita/frontend\"",
    "test": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present && vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
